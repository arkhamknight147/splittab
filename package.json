{
  "name": "splittab",
  "version": "2.1.1",
  "private": true,
  "description": "Zero-install restaurant bill splitting for India (Cloudflare Workers + D1 + Gemini)",
  "scripts": {
    "db:local": "wrangler d1 migrations apply splittab --local",
    "db:remote": "wrangler d1 migrations apply splittab --remote",
    "dev": "wrangler dev",
    "dev:mock": "wrangler dev --var GEMINI_MOCK:1",
    "test": "node tests/math.test.mjs",
    "deploy": "wrangler deploy",
    "css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/app.css --content ./public/index.html --minify"
  },
  "devDependencies": {
    "wrangler": "^4.155.0",
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=22"
  }
}
