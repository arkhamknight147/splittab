{
    "name": "SplitTab - Receipt Processor",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "maxResults": 1
            },
            "interface": [
                {
                    "name": "host_name",
                    "type": "text"
                },
                {
                    "name": "host_vpa",
                    "type": "text"
                },
                {
                    "name": "actual_paid_amount",
                    "type": "number"
                },
                {
                    "name": "participants_list",
                    "spec": {
                        "name": "value",
                        "type": "text"
                    },
                    "type": "array"
                },
                {
                    "name": "image_base64",
                    "type": "text"
                }
            ]
        },
        {
            "id": 3,
            "module": "http:MakeRequest",
            "version": 4,
            "parameters": {
                "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=YOUR_GEMINI_API_KEY",
                "method": "post",
                "headers": [
                    {
                        "name": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "timeout": 40,
                "contentType": "json",
                "inputMethod": "jsonString",
                "parseResponse": true,
                "jsonStringBodyContent": "{\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are an expert OCR financial parser for Indian dining receipts. Extract all items, food GST (cgst_amount, sgst_amount), liquor_vat_amount, service_charge, subtotal, and grand_total. Set is_alcohol to true if alcoholic. Output STRICT RAW JSON with no markdown tags matching this schema: {\\\"items\\\": [{\\\"item_name\\\": \\\"\\\", \\\"quantity\\\": 1, \\\"unit_price\\\": 0.0, \\\"total_price\\\": 0.0, \\\"is_alcohol\\\": false}], \\\"cgst_amount\\\": 0.0, \\\"sgst_amount\\\": 0.0, \\\"liquor_vat_amount\\\": 0.0, \\\"service_charge\\\": 0.0, \\\"subtotal\\\": 0.0, \\\"grand_total\\\": 0.0}\"\n        },\n        {\n          \"inline_data\": {\n            \"mime_type\": \"image/jpeg\",\n            \"data\": \"{{1.image_base64}}\"\n          }\n        }\n      ]\n    }\n  ]\n}"
            }
        },
        {
            "id": 4,
            "module": "json:ParseJSON",
            "version": 1,
            "parameters": {
                "json": "{{3.data.candidates[].content.parts[].text}}"
            }
        },
        {
            "id": 6,
            "module": "supabase:createARow",
            "version": 1,
            "parameters": {
                "table": "sessions",
                "host_vpa": "{{1.host_vpa}}",
                "host_name": "{{1.host_name}}",
                "cgst_amount": "{{4.cgst_amount}}",
                "sgst_amount": "{{4.sgst_amount}}",
                "bill_subtotal": "{{4.subtotal}}",
                "service_charge": "{{4.service_charge}}",
                "bill_grand_total": "{{4.grand_total}}",
                "liquor_vat_amount": "{{4.liquor_vat_amount}}",
                "actual_paid_amount": "{{1.actual_paid_amount}}"
            }
        },
        {
            "id": 13,
            "module": "gateway:WebhookRespond",
            "version": 1,
            "parameters": {
                "status": 200,
                "body": "{\n  \"session_id\": \"{{6.id}}\"\n}",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Access-Control-Allow-Origin",
                        "value": "*"
                    }
                ]
            }
        },
        {
            "id": 8,
            "module": "builtin:BasicRouter",
            "version": 1,
            "routes": [
                {
                    "flow": [
                        {
                            "id": 9,
                            "module": "builtin:BasicFeeder",
                            "parameters": {
                                "array": "{{1.participants_list}}"
                            }
                        },
                        {
                            "id": 11,
                            "module": "supabase:createARow",
                            "parameters": {
                                "table": "participants",
                                "session_id": "{{6.id}}",
                                "name": "{{9.value}}",
                                "payment_status": "UNPAID"
                            }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 10,
                            "module": "builtin:BasicFeeder",
                            "parameters": {
                                "array": "{{4.items}}"
                            }
                        },
                        {
                            "id": 12,
                            "module": "supabase:createARow",
                            "parameters": {
                                "table": "line_items",
                                "session_id": "{{6.id}}",
                                "item_name": "{{10.item_name}}",
                                "quantity": "{{10.quantity}}",
                                "unit_price": "{{10.unit_price}}",
                                "total_price": "{{10.total_price}}",
                                "is_alcohol": "{{10.is_alcohol}}"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}